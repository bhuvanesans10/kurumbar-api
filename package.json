{
  "name": "@kurumbar/api",
  "version": "0.1.0",
  "description": "Kurumbar Community Platform Backend Application Server",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "jest",
    "start": "nest start",
    "start:prod": "nest start --prod",
    "start:watch": "nest start --watch",
    "start:debug": "nest start --debug",
    "start:debugger": "nest start --debug --watch",
    "build": "nest build",
    "build:deploy": "nest build -c nest-cli.swc.json",
    "format": "prettier -w src/",
    "db:migrate-save": "prisma migrate dev",
    "prisma:migrate-deploy": "prisma migrate deploy",
    "db:clean": "prisma migrate reset",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^9.3.0",
    "@nestjs/common": "11.1.17",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.17",
    "@nestjs/platform-fastify": "^11.1.17",
    "@nestjs/swagger": "11.2.6",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.9.1",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@sentry/nestjs": "^10.45.0",
    "@sentry/profiling-node": "^10.45.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "17.3.1",
    "fastify": "^5.8.2",
    "prisma": "7.9.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.spec.ts",
      "!src/**/*.module.ts",
      "!src/**/*.dto.ts",
      "!src/**/*.interface.ts",
      "!src/**/*.entity.ts",
      "!src/prisma/generated/**",
      "!src/swagger.ts",
      "!src/main.ts",
      "!src/global-exceptions.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "functions": 85,
        "branches": 75,
        "statements": 90
      }
    }
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "^11.1.17",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.18",
    "@types/jest": "^30.0.0",
    "@types/node": "25.5.0",
    "jest": "^30.3.0",
    "jest-environment-node": "30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.27.0"
}
